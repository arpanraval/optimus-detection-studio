# ===========================================
# Client-Side Environment Variables (Vite)
# ===========================================

# Supabase project configuration
# Use a publishable (sb_publishable_...) or legacy anon key. Never a secret/service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional local/private vendor proxy. Leave unset to use stored server credentials on localhost.
# VITE_SIEM_DEV_PROXY=true

# ===========================================
# Edge Function Secrets (set via Supabase CLI, NOT in this file)
#   supabase secrets set KEY=value
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are auto-injected
# into edge functions — never set them yourself (the CLI rejects SUPABASE_* names).
# ===========================================

# Required for the full AI experience: Gemini powers embeddings and semantic search.
# Anthropic is REQUIRED for Threat Research + Detection Finetuning; OpenAI is an
# optional generation provider.
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Required for SIEM integrations: 32-byte hex AES-GCM key.
# Generate with:  bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# WARNING: never change this once integration credentials are stored, or they can't be decrypted.
# INTEGRATION_ENCRYPTION_KEY=your-32-byte-hex-key

# Optional: managed-agent detection finetuning (SETUP.md step 6b).
# Needs ANTHROPIC_API_KEY (same account) + a Defender XDR integration.
# Provision once with: ANTHROPIC_API_KEY=... bun scripts/setup-finetune-agent.ts
# FINETUNE_AGENT_ID=agent_...
# FINETUNE_ENVIRONMENT_ID=env_...

# Optional: Threat-intel web search
# TAVILY_API_KEY=your-tavily-api-key

# Optional: legacy demo-request endpoint notifications (not used by the OSS landing page)
# RESEND_API_KEY=your-resend-api-key
# DEMO_NOTIFY_EMAIL=you@example.com

# Optional: CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://your-domain.com

# Optional: Site URL for email links
# SITE_URL=https://your-domain.com
