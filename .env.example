# ===========================================
# Client-Side Environment Variables (Vite)
# ===========================================

# Supabase project configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App environment (development | production)
VITE_APP_ENV=development

# ===========================================
# Edge Function Secrets (set via Supabase CLI)
# supabase secrets set KEY=value
# ===========================================

# Required: AI Provider API Keys (at least one)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Required: Supabase service role (for edge functions)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Threat intelligence
# TAVILY_API_KEY=your-tavily-api-key

# Optional: CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://your-domain.com

# Optional: Site URL for email links
# SITE_URL=https://your-domain.com
