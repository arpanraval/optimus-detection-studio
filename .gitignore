# Accidental home/profile directories (Windows path resolution artifacts)
~/
%USERPROFILE%/

# Bun cache
.bun/

# Lock files
# bun.lock is committed so CI, Vercel, and forks install identical, reproducible
# dependency versions (an uncommitted lockfile let newer deps break type-check).
package-lock.json
# deno.lock is NOT committed: CI type-checks the edge functions with
# `deno check --no-lock`, so a tracked lockfile would pin nothing CI reads
# while churning on every local check.
deno.lock

# Windows artifacts
nul

# Loose audit / design-iteration screenshots at the repo root.
# Tracked PNGs live under public/ or src/ and are not affected.
/*.png

