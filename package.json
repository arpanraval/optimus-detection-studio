{
  "name": "optimus-detection-studio",
  "private": true,
  "engines": {
    "node": ">=24 <26"
  },
  "version": "1.0.0",
  "description": "AI-powered detection engineering & detection-intelligence platform — choose, build, quality-check, and operationalize SIEM/XDR detections with MITRE ATT&CK mapping, Sigma conversion, and threat-intel-driven gap analysis.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/arpanraval/optimus-detection-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpanraval/optimus-detection-studio.git"
  },
  "bugs": {
    "url": "https://github.com/arpanraval/optimus-detection-studio/issues"
  },
  "keywords": [
    "detection-engineering",
    "detection-as-code",
    "siem",
    "xdr",
    "mitre-attack",
    "sigma",
    "threat-intelligence",
    "security",
    "soc",
    "supabase"
  ],
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "bunx tsc --noEmit",
    "type-check:setup": "bunx tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --esModuleInterop --types node scripts/setup.ts scripts/setup-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "bun run scripts/setup.ts",
    "setup:check": "bun run scripts/setup-check.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.52.0",
    "@heroicons/react": "^2.2.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/dagre": "^0.7.54",
    "@types/dompurify": "^3.2.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.3.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.55.1",
    "pyodide": "^0.26.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
